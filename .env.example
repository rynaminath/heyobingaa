# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Client Configuration (Renewed after rotation)
# Set these in your local .env.local file or in GitHub Repository Secrets (Actions Secrets).
# Never commit real API keys to public repositories.
VITE_FIREBASE_API_KEY="your_renewed_firebase_api_key_here"
VITE_FIREBASE_AUTH_DOMAIN="gen-lang-client-0438186568.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="gen-lang-client-0438186568"
VITE_FIREBASE_STORAGE_BUCKET="gen-lang-client-0438186568.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123260512237"
VITE_FIREBASE_APP_ID="1:123260512237:web:a946e7308b80af02a129e4"
VITE_FIRESTORE_DATABASE_ID="ai-studio-heyobingaango-5be7811f-1395-41ff-8b43-21809cd861ac"

